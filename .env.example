# Railway Environment Variables
# Set these in Railway Dashboard → Variables

# API Keys (required for full pipeline)
LIGHTCAST_API_KEY=your_l...n

# Pipeline control
FORCE_REFRESH=0  # Set to 1 to force re-run pipeline on deploy

# Streamlit
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# Optional: Analytics
SENTRY_DSN=
PLAUSIBLE_DOMAIN=

# --- LLM Intelligence Layer ---
# Provider-agnostic via LiteLLM. Default is Anthropic Claude.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Per-tier model overrides (optional; sensible Claude defaults apply)
LLM_MODEL_BATCH=
LLM_MODEL_INTERACTIVE=
LLM_MODEL_HARD=
# Hard ceiling on output tokens per run (safety guard)
LLM_TOKEN_BUDGET=2000000

# Public-deploy cost guards for the Ask page
ASK_SESSION_LIMIT=10           # questions per browser session
ASK_DAILY_TOKEN_CAP=200000     # shared daily token ceiling

# Skill source for the dashboard: 'llm' (default; falls back to dictionary if
# job_skills_llm is absent) or 'flashtext'
SKILLS_METHOD=llm

# --- Lead capture (in-app name+email form) ---
# The "Stay in the loop" form captures name + email in-app (no mail client needed)
# and relays each submission to you. Configure ONE of:
CONTACT_EMAIL=         # simplest: relays via FormSubmit's free no-account endpoint
                       # (you click a one-time activation email, then leads arrive in this inbox)
LEAD_WEBHOOK_URL=      # optional: a form endpoint (Formspree/Web3Forms/Google Apps Script)
                       # that accepts JSON {name,email,interest}. Overrides CONTACT_EMAIL.
# Submissions are also appended to data/processed/leads.csv (best-effort local backup).
